# systemd --user unit for yatagarasu-server (mcpbox meisei planning tool).
# Independent deploy unit: updating yatagarasu rebuilds/redeploys ONLY this
# service, never the mcpbox platform or daruma.
#
# Install: copy the built binary to ~/.local/bin/yatagarasu-server, drop this
# file at ~/.config/systemd/user/yatagarasu-server.service, put
# YATAGARASU_PLATFORM_SECRET (the platform-shared key) in
# ~/.config/yatagarasu/yatagarasu.env, then:
#   systemctl --user daemon-reload && systemctl --user enable --now yatagarasu-server
# Front it with nginx `yatagarasu.mcpbox.ru -> 127.0.0.1:$YATAGARASU_PORT` and
# upsert the tool_registry row on the platform.

[Unit]
Description=yatagarasu-server (mcpbox meisei planning tool)
After=network-online.target

[Service]
Environment=YATAGARASU_PORT=8093
Environment=YATAGARASU_VERSION=0.1.0
# Persistent object/event store; create %h/.local/share/yatagarasu before first start.
Environment=YATAGARASU_DB=%h/.local/share/yatagarasu/yatagarasu.db
# YATAGARASU_PLATFORM_SECRET (and any future keys) live here, NOT in this unit:
# OPENAI_API_KEY[/OPENAI_BASE_URL/OPENAI_MODEL] also goes there — without it
# the AI methods `yatagarasu.plan` / `decompose` / `scope` / `analyze_complexity`
# answer ai_not_configured (503).
EnvironmentFile=-%h/.config/yatagarasu/yatagarasu.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/yatagarasu
ExecStart=%h/.local/bin/yatagarasu-server
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
